#getting base image ubuntu
FROM ubuntu:24.04
MAINTAINER Jagmohan <jagmohan.prasad@outlook.com>
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y zlib1g-dev libicu-dev g++

RUN apt-get update --fix-missing && \
    apt-get install -y software-properties-common && \
    add-apt-repository ppa:ondrej/php -y && \
    apt-get update && \
    apt-get install -y \
        php8.4 \
        php8.4-cli \
        php8.4-common \
        php8.4-mysql \
        php8.4-curl \
        php8.4-zip \
        php8.4-gd \
        php8.4-fpm \
        php8.4-bz2 \
        php8.4-xml \
        php8.4-dev \
        php8.4-pgsql \
        php8.4-bcmath \
        php8.4-mbstring \
        php8.4-intl && \
        # php8.4-json \
    apt-get clean && rm -rf /var/lib/apt/lists/*


RUN apt-get update --fix-missing && \
    apt-get install -y --no-install-recommends php8.4-redis

RUN apt-get update --fix-missing && apt-get install libapache2-mod-php8.4 php-pear -y

RUN apt-get install -y nginx
RUN apt-get install sudo -y
RUN curl -O https://getcomposer.org/download/latest-2.2.x/composer.phar \
    && mv composer.phar /usr/local/bin/composer \
    && chmod +x /usr/local/bin/composer
    
RUN echo "date.timezone = Asia/Kolkata" > /etc/php/8.4/fpm/php.ini

# Create directory for pid file
RUN mkdir -p /run/php

EXPOSE 82/tcp
CMD service php8.4-fpm start && nginx -g "daemon off;"
WORKDIR /var/www